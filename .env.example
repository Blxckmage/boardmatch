# Copy to .env and fill in. Never commit .env.
# Server-side BGG API token (required for live collection fetch).
# Deploy reads this file (alchemy --env-file, defaults to .env) and binds it
# as secret_text on the Website worker — no `secret set` command needed.
BGG_TOKEN=
# Optional: override the server URL (e.g. preview backend URL for local dev).
SERVER_URL=
# Optional: client-side app title (VITE_ prefix = exposed to the browser).
VITE_APP_TITLE=Boardmatch
