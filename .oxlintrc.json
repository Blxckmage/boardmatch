{
	"$schema": "https://cdn.jsdelivr.net/gh/oxc-project/oxlint@latest/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"pedantic": "warn",
		"perf": "warn",
